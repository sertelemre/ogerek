{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // ogerek.com: the products home page (/) and each product under /<product>.
  // More specific routes (e.g. ogerek.com/snaptable/api/* for the license Worker) take precedence.
  "name": "ogerek-products",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "ogerek.com/*", "zone_name": "ogerek.com" },
    { "pattern": "www.ogerek.com/*", "zone_name": "ogerek.com" }
  ],
  "workers_dev": false,
  "preview_urls": false
}
